* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--text);
  line-height: 1.7;
}

header {
  background: var(--white);
  border-bottom: 3px solid var(--gold);
  padding: 15px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.brand { color: var(--blue); font-size: 25px; font-weight: 800; }
.brand span { display: block; color: #65758a; font-size: 11px; letter-spacing: 2px; }

nav { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; }
nav a { color: var(--blue); text-decoration: none; font-weight: 600; }
nav a:hover { color: #a57a25; }
.language { border: 1px solid #d8dee8; padding: 7px 10px; border-radius: 6px; background: white; cursor: pointer; }

.hero {
  background: linear-gradient(120deg, rgba(10,32,59,.97), rgba(18,52,90,.91));
  color: white;
  padding: 90px 7%;
  text-align: center;
}

.hero .eyebrow { color: #f1ce82; letter-spacing: 3px; font-weight: bold; }
.hero h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1.15; max-width: 900px; margin: 20px auto; }
.hero p { font-size: 19px; max-width: 760px; margin: 0 auto 30px; color: #e7edf5; }
.button {
  display: inline-block;
  background: var(--gold);
  color: #10243d;
  padding: 13px 24px;
  margin: 5px;
  border-radius: 5px;
  text-decoration: none;
  font-weight: bold;
}
.button.outline { background: transparent; border: 1px solid white; color: white; }

section { padding: 65px 7%; }
.section-title { text-align: center; color: var(--blue); font-size: 32px; margin: 0 0 12px; }
.section-intro { text-align: center; max-width: 760px; margin: 0 auto 35px; }
.gold-line { width: 65px; height: 4px; background: var(--gold); margin: 15px auto 25px; }

.about { background: var(--light); }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 22px; }
.card {
  background: white;
  padding: 27px;
  border-radius: 9px;
  box-shadow: 0 5px 20px rgba(20,40,70,.07);
  border-top: 3px solid var(--gold);
}
.card h3 { color: var(--blue); margin-top: 0; }
.icon { font-size: 30px; }

.callout { background: var(--blue); color: white; text-align: center; }
.callout h2 { font-size: 30px; }
.callout p { max-width: 750px; margin: 0 auto 20px; }

.contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 25px; }
.contact-box { background: var(--light); padding: 25px; border-radius: 8px; }
.contact-box h3 { color: var(--blue); }

footer { background: var(--blue-dark); color: #e5eaf1; padding: 30px 7%; text-align: center; }
footer a { color: #f1ce82; }
.small { font-size: 13px; color: #c5cfdb; }

@media (max-width: 700px) {
  header { justify-content: center; text-align: center; }
  nav { justify-content: center; gap: 12px; }
  .hero { padding: 65px 6%; }
  section { padding: 48px 6%; }
}
